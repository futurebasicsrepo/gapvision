node_modules/
dist/
__pycache__/
*.pyc
.vercel/
.env
.env.*
*.log
.DS_Store
nohup.out
dist-preview/

# Even Hub packages — built artifacts, never committed
*.ehpk

# Git bundles. These are the sandbox→Mac push relay (see claude/handoff.md):
# a bundle is a transport for commits that are already in history, so
# committing one would store the repo inside the repo.
*.bundle

# esbuild output for the layout unit test
packages/glasses-plugin/dist-test/

# Generated plate artwork. Per-tenant, per-zone, and regenerated in a second
# from build-plates.py — committing print files means the repo carries a
# snapshot of a store layout that changes every time a fitting room is renamed.
packages/brand/out/

# Built into Console by scripts/sync-lens-sim.mjs from packages/meta-lens.
# The source of truth is that package; this is a copy, and a copy in git is a
# copy that goes stale.
packages/internal/public/lens-sim/
