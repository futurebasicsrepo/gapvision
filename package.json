{
  "name": "cue",
  "private": true,
  "version": "0.5.0",
  "description": "CueSea \u2014 e-commerce level intelligence for retail floor associates, in-lens.",
  "workspaces": [
    "packages/lens-core",
    "packages/server",
    "packages/web",
    "packages/glasses-plugin",
    "packages/internal",
    "packages/meta-lens"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=packages/server",
    "dev:web": "npm run dev --workspace=packages/web",
    "dev:plugin": "npm run dev --workspace=packages/glasses-plugin",
    "dev:meta": "npm run dev --workspace=packages/meta-lens",
    "build:meta": "npm run build --workspace=packages/meta-lens",
    "test:meta": "npm run test --workspace=packages/meta-lens",
    "dev:ai": "cd packages/ai-service && uvicorn app.main:app --reload --port 8000",
    "build": "npm run build --workspace=packages/web",
    "test:ai": "cd packages/ai-service && python -m pytest tests -q",
    "test:voice": "node packages/server/test/voice-e2e.mjs",
    "test:voice-browser": "node packages/glasses-plugin/test/voice-browser.mjs",
    "test:gestures": "node packages/glasses-plugin/test/gestures.test.mjs",
    "test:endpointing": "node packages/glasses-plugin/test/endpointing.test.mjs",
    "test:pageshape": "npx esbuild packages/glasses-plugin/src/layout.ts --bundle --format=esm --external:./bridge --outfile=packages/glasses-plugin/dist-test/layout.mjs && node packages/glasses-plugin/test/page-shape.test.mjs",
    "test:gestures-browser": "node packages/glasses-plugin/test/gestures-browser.mjs",
    "test:doors": "node packages/server/test/presence-door.mjs",
    "test:checkin": "node packages/web/test/checkin-browser.mjs",
    "test:plates": "python3 packages/brand/test-plates.py",
    "db:migrate": "cd packages/ai-service && python -c \"from app import db; db.migrate()\"",
    "db:seed": "cd packages/ai-service && python -m app.seed",
    "test:spine": "node packages/server/test/spine-e2e.mjs",
    "test:tenants": "node packages/server/test/tenant-isolation.mjs",
    "test:floor-dm": "node packages/server/test/floor-dm.mjs",
    "test:widgets": "npx esbuild packages/glasses-plugin/src/widgets.ts --bundle --format=esm --external:./bridge --outfile=packages/glasses-plugin/dist-test/widgets.js && node packages/glasses-plugin/test/widgets.test.mjs",
    "test:widgets-browser": "node packages/glasses-plugin/test/widgets-browser.mjs",
    "test:settings": "node packages/web/test/settings-browser.mjs",
    "test:floor-dm-browser": "node packages/glasses-plugin/test/floor-dm-browser.mjs",
    "test:dashboard": "node packages/web/test/dashboard-browser.mjs",
    "build:web": "npm run build --workspace=packages/web",
    "build:plugin": "npm run build --workspace=packages/glasses-plugin",
    "brand:sync": "node packages/brand/build.mjs",
    "dev:internal": "npm run dev --workspace=packages/internal",
    "build:internal": "npm run build --workspace=packages/internal",
    "test:console": "node packages/internal/test/console-browser.mjs",
    "test:attribution": "node packages/internal/test/attribution-e2e.mjs",
    "render:lens": "npx esbuild packages/glasses-plugin/src/layout.ts --bundle --format=esm --external:./bridge --outfile=packages/glasses-plugin/dist-test/layout.mjs && npx esbuild packages/glasses-plugin/src/hero.ts --bundle --format=esm --outfile=packages/glasses-plugin/dist-test/hero.mjs && python3 packages/glasses-plugin/test/render-lens.py",
    "test:bundle": "node packages/glasses-plugin/test/packaged-bundle.test.mjs",
    "brand:assets": "python3 packages/brand/build-assets.py",
    "test:cards": "npx esbuild packages/glasses-plugin/src/cards.ts --bundle --format=esm --external:./bridge --outfile=packages/glasses-plugin/dist-test/cards.js && npx esbuild packages/glasses-plugin/src/layout.ts --bundle --format=esm --external:./bridge --outfile=packages/glasses-plugin/dist-test/layout.js && node packages/glasses-plugin/test/cards.test.mjs",
    "docs:onepager": "python3 docs/employee-one-pager.py",
    "test:capabilities": "node packages/glasses-plugin/test/capabilities.test.mjs",
    "test:vision-browser": "node packages/glasses-plugin/test/vision-browser.mjs",
    "test:devices": "cd packages/ai-service && python -m pytest tests/test_devices.py -q",
    "test:device-register": "node packages/server/test/device-register.mjs",
    "test:devices-console": "node packages/internal/test/devices-browser.mjs",
    "test:lens-sim": "node packages/internal/test/lens-sim-browser.mjs",
    "test:devices-studio": "node packages/web/test/devices-browser.mjs",
    "test:sales": "node packages/internal/test/sales-browser.mjs",
    "dev:sales": "npx --yes serve packages/sales-site -l 8902",
    "test:mobile": "node packages/internal/test/mobile-browser.mjs",
    "test:lens-core": "npm test --workspace=packages/lens-core"
  }
}
